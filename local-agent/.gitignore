.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Rust Analyzer
.rust-analyzer/

# Build artifacts
*.exe
*.dll
*.so
*.dylib

# Test coverage
*.profraw
*.profdata
coverage/

