      "content": "ai:\r\n  host: \"localhost\"\r\n  port: 50051\r\n\r\ngateway:\r\n  host: \"localhost\"\r\n  port: 8080\r\n\r\nredis:\r\n  host: \"localhost\"\r\n  port: 6379\r\n  db: 0\r\n  password: \"\"\r\n\r\ndatabase:\r\n  host: \"localhost\"\r\n  port: 9002\r\n  user: \"user\"\r\n  password: \"password\"",
