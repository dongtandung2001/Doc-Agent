# ---- Rust/Cargo ----
/target/
**/target/
debug/
release/

# Common compiled artifacts (usually live under target anyway)
*.o
*.a
*.rlib
*.rmeta
*.dylib
*.so
*.dll
*.bin
*.d
*.timestamp

# ---- Logs & temp ----
*.log
*.tmp
*.bak
*.swp
*.swo

# ---- Env & local config (only if you actually use them) ----
.env
.env.*

# ---- Editors/IDEs ----
.vscode/
.idea/

# ---- OS junk ----
.DS_Store
Thumbs.db
Icon?

# ---- Optional: build/output dirs you might create ----
/dist/
/build/
/out/
/bin/

# Custom ignores
.claude
*.mermaid

# Ignore all Markdown files
*.md

# But keep README.md
!README.md
backend/ai-service/venv/
backend/ai-service/__pycache__/
backend/ai-service/venv.backup.20251117_210531/
*.pyc
backend/services/ai-service/src/__pycache__/*
